# Render injects PORT automatically. Use this only for local development if needed.
PORT=3001

# Comma-separated list of allowed frontend origins.
# Replace the Netlify URL with the production URL for the PXT Player frontend.
CORS_ORIGIN=https://your-pxt-player.netlify.app

# Timeout for Xtream validation requests in milliseconds.
XTREAM_TIMEOUT_MS=10000
